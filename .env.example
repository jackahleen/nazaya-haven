# Nazaya Haven Environment Variables
#
# STATIC PREVIEW (GitHub Pages) does NOT need any of these variables.
# They are used only by:
# - Vercel hosted runtime (VERCEL / NAZAYA_RUNTIME=hosted)
# - GitHub Actions CI workflows (secrets.*)
#
# Copy this file to .env.local (never committed) for local hosted-runtime testing.
# For Vercel, add secrets via: vercel env add VAR_NAME
#
# Client code only sees NEXT_PUBLIC_* variables.

# ============================================================================
# VERCEL HOSTED RUNTIME SECRETS (server-side only, never on GitHub Pages)
# ============================================================================

# Anthropic Claude API
# Used by: /api/chat for chat completion, web search, document guidance
# Provider: Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# Deepgram Voice API
# Used by: /api/voice/deepgram/token endpoint for caregiver voice intake
# Provider: Deepgram
DEEPGRAM_API_KEY=xxx

# Redis Cache & Agent Traces
# One of REDIS_URL or (UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN) required
# Used by: app cache, agent trace persistence
# Provider: Redis (self-hosted or Upstash)
REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# Fetch.ai uAgents Orchestration
# Used by: resource-routing agent handoff via dispatch contracts
# Provider: Fetch.ai
AGENTVERSE_API_TOKEN=xxx
UAGENTS_WORKER_ENDPOINT=https://xxx.agent.fetch.ai

# Orkes Conductor Workflow Orchestration
# Used by: durable resource, notification, form-start workflows
# Provider: Orkes
CONDUCTOR_SERVER_URL=https://xxx.conductor.orkes.io/api
CONDUCTOR_AUTH_TOKEN=xxx

# ============================================================================
# CLIENT-PUBLIC VARIABLES (safe to expose in browser; NEXT_PUBLIC_*)
# ============================================================================

# Sentry Frontend Observability DSN
# Used by: frontend error tracking, session replay, release annotations
# Available to: all surfaces (static, GA CI, Vercel)
# Provider: Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# GitHub Pages Base Path
# Set by GitHub Pages workflow for repository pages (e.g., /nazaya-haven)
# Leave blank for user/org pages (e.g., username.github.io)
# Provider: GitHub Pages
NEXT_PUBLIC_BASE_PATH=

# ============================================================================
# GITHUB ACTIONS CI SECRETS (validation, smoke tests, source maps)
# ============================================================================

# Browserbase Cloud Browser Automation
# Used by: playwright smoke tests, browser sessions
# Provider: Browserbase
BROWSERBASE_API_KEY=xxx
# BROWSERBASE_PROJECT_ID=xxx (optional; SDK can infer from key)

# OpenAI (Demo Video & Agent-S Grounding)
# Used by: Agent-S demo video production in CI
# Provider: OpenAI
OPENAI_API_KEY=sk-xxx

# Hugging Face Token
# Used by: demo agent grounding
# Provider: Hugging Face
HF_TOKEN=hf_xxx

# Agent-S Grounding Server
# Used by: demo-video.yml Agent-S simulation
# Provider: Simular Agent-S
AGENT_S_GROUND_URL=https://xxx

# Simular Demo Command Override
# Optional pre-built command for demo capture
# Provider: Simular
# SIMULAR_DEMO_COMMAND=xxx

# Sentry Auth Token
# Used by: source map upload, release annotation
# Provider: Sentry
SENTRY_AUTH_TOKEN=sntrysxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Pages Deploy Token
# Auto-provided by GitHub Actions as GITHUB_TOKEN
# Only override if using a custom token
# GH_PAGES_DEPLOY_TOKEN=ghp_xxx

# ============================================================================
# RUNTIME CONTROL (local testing only, never on Vercel)
# ============================================================================

# Force hosted-runtime behavior locally (disables static export)
# When set to 'hosted', next.config disables output: "export"
# Allows testing /api routes and server secrets locally
# NAZAYA_RUNTIME=hosted

# VERCEL is auto-set by Vercel platform to '1'
# Do not override unless testing locally
# VERCEL=
