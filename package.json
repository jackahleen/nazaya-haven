{
  "name": "nazaya-haven",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run build:static",
    "build:static": "next build",
    "build:hosted": "node tools/build-hosted.mjs",
    "start": "next start",
    "start:hosted": "node tools/start-hosted.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "serve:static": "serve out -l tcp://127.0.0.1:3000",
    "test:e2e": "npm run test:static",
    "test:static": "playwright test",
    "test:static:chromium": "playwright test --project=chromium",
    "test:button-proofs": "playwright test tests/e2e/button-proofs.spec.ts --project=chromium",
    "test:hosted-api": "playwright test --config=playwright.config.hosted.ts",
    "test:runtime": "playwright test tests/e2e/static-runtime.spec.ts tests/e2e/review-fixes.spec.ts tests/e2e/phone-links.spec.ts --project=chromium",
    "test:browserbase": "playwright test --config=playwright.config.browserbase.ts",
    "verify:button-proofs": "npm run build && npm run test:button-proofs",
    "demo:record": "node tools/demo/record-walkthrough.mjs",
    "verify": "npm run verify:deploy",
    "verify:pages": "npm run typecheck && npm run lint && npm run build:static",
    "verify:static": "npm run verify:pages && npm run test:static",
    "verify:hosted": "npm run typecheck && npm run lint && npm run build:hosted",
    "verify:deploy": "npm run verify:static && npm run verify:hosted && npm run test:hosted-api && npm run test:browserbase",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@browserbasehq/sdk": "^2.14.1",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.3.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
